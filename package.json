{
  "name": "rovli-radyo",
  "version": "0.3.2",
  "private": true,
  "description": "Rovli Radyo — yerel ağ dijital kafe radyosu",
  "author": "Rovli",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:ui\" \"npm:dev:electron\"",
    "dev:server": "node server/index.cjs",
    "dev:ui": "vite --host 0.0.0.0",
    "dev:electron": "wait-on tcp:5173 tcp:8090 && set CAFE_RADIO_DEV=1&& electron .",
    "build": "vite build",
    "start": "node server/index.cjs",
    "desktop": "electron .",
    "test": "npm run test:server && npm run test:ui",
    "test:server": "node --test --test-concurrency=1 --test-timeout=300000 \"tests/**/*.test.cjs\"",
    "test:ui": "vitest run",
    "pack": "npm test && npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.0.2",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^29.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3",
    "vitest": "^4.1.11",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.rovliradyo.local",
    "productName": "Rovli Radyo",
    "artifactName": "RovliRadyoSetup-${version}.${ext}",
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Erginiz",
        "repo": "ROVL-_COFFEE",
        "releaseType": "release"
      }
    ],
    "files": [
      "dist/**",
      "electron/**",
      "server/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Rovli Radyo",
      "include": "build/installer.nsh"
    },
    "extraResources": [
      "dist"
    ]
  }
}
